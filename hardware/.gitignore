
# Vivado Project & Build Folders
# Ignore the entire directory where generated projects, runs, and caches live
vivado-data/
work/
*.xpr

# IP Cores 
ip/**/*
!ip/**/
# keep the IP configuration source files
!ip/**/*.xci
!ip/**/*.xcix


# Vivado Logs, Journals, and Crash Files
# Vivado drops these in whatever directory you launch it from
*.jou
*.log
*.str
*.dmp
hs_err_pid*.log

# Simulation & Debug Data
*.wdb
*.vcd
*.hw/
*.sim/
*.pb

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
